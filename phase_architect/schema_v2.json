{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "basis",
  "phases",
  "workstreams",
  "governance",
  "architect_notes"
 ],
 "properties": {
  "basis": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "governing_question",
    "archetype_id"
   ],
   "properties": {
    "governing_question": {
     "type": "string"
    },
    "archetype_id": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "phases": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "order",
     "duration_weeks",
     "duration_derived",
     "objective_one_line",
     "gate",
     "depends_on_assumptions"
    ],
    "properties": {
     "name": {
      "type": "string",
      "enum": [
       "Diagnostic",
       "Research",
       "Design",
       "Pilot",
       "Implementation",
       "Change & Training",
       "Measurement",
       "Handover"
      ]
     },
     "order": {
      "type": "integer"
     },
     "duration_weeks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "min",
       "max"
      ],
      "properties": {
       "min": {
        "type": "integer"
       },
       "max": {
        "type": "integer"
       }
      }
     },
     "duration_derived": {
      "type": "boolean"
     },
     "objective_one_line": {
      "type": "string"
     },
     "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "label",
       "decision"
      ],
      "properties": {
       "label": {
        "type": "string"
       },
       "decision": {
        "type": "string"
       }
      }
     },
     "depends_on_assumptions": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "engagement_type",
        "engagement_length",
        "stakeholders",
        "deliverable_format",
        "timeline",
        "prior_attempts",
        "success_criteria",
        "out_of_scope"
       ]
      }
     }
    }
   }
  },
  "workstreams": {
   "type": "array",
   "minItems": 1,
   "maxItems": 8,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "phase_order",
     "name",
     "answers",
     "traces_to",
     "start_offset",
     "duration",
     "follows",
     "activities",
     "deliverables"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "phase_order": {
      "type": "integer"
     },
     "name": {
      "type": "string"
     },
     "answers": {
      "type": "string"
     },
     "traces_to": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "start_offset": {
      "type": "integer"
     },
     "duration": {
      "type": "integer"
     },
     "follows": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "activities": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "deliverables": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "name",
        "kind",
        "due_week_in_phase"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "kind": {
         "type": "string",
         "enum": [
          "analysis",
          "design",
          "build",
          "decision_pack",
          "enablement"
         ]
        },
        "due_week_in_phase": {
         "type": "integer"
        }
       }
      }
     }
    }
   }
  },
  "governance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "status_cadence_weeks",
    "events"
   ],
   "properties": {
    "status_cadence_weeks": {
     "type": "integer",
     "enum": [
      1,
      2
     ]
    },
    "events": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "type",
       "phase_order",
       "week_in_phase",
       "label",
       "purpose",
       "presents",
       "decision",
       "agenda",
       "attendees"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "type": {
        "type": "string",
        "enum": [
         "kickoff",
         "checkin",
         "workshop",
         "gate"
        ]
       },
       "phase_order": {
        "type": "integer"
       },
       "week_in_phase": {
        "type": "integer"
       },
       "label": {
        "type": "string"
       },
       "purpose": {
        "type": "string"
       },
       "presents": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "decision": {
        "type": [
         "string",
         "null"
        ]
       },
       "agenda": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "attendees": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "architect_notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}