{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proposal_summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objectives",
    "solution",
    "outcomes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "problem_statement",
              "success_criteria",
              "brief_narrative"
            ]
          }
        }
      }
    },
    "solution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "kind",
          "phases"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "overview",
              "phase",
              "scope"
            ]
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "from"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase_order",
                "deliverable"
              ],
              "properties": {
                "phase_order": {
                  "type": "integer",
                  "minimum": 1
                },
                "deliverable": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}